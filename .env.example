# ---- ROZLF AUTO TRADER ----
# Copy to .env for local runs. Never commit the real .env.

# Encrypts stored account passwords. Use a long random string in production.
APP_SECRET_KEY=change-me-to-a-long-random-value
# Old keys, comma separated, used only to decrypt existing sessions during rotation.
APP_SECRET_KEY_PREVIOUS=

# No dashboard password is required. Website access is granted by a short-lived
# one-time link issued from the owner's Telegram bot after ExpertOption verifies.

# Real-money execution stays locked unless this is exactly "true".
# Leave false until demo testing is complete and you approve it explicitly.
REAL_TRADING_APPROVED=false

# MT5 live bridge: requires Windows + MetaTrader 5 terminal + an HTTP bridge.
MT5_ENABLED=false
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
# Shared HMAC secret used by the bridge and Render (same value on both sides).
MT5_BRIDGE_SECRET=
MT5_BRIDGE_TIMEOUT_MS=15000
# Reject trading when the last successful account sync is older than this.
MT5_ACCOUNT_SYNC_MAX_AGE_SECONDS=30
# Minimum seconds before the same symbol may be traded again.
TRADE_REENTRY_COOLDOWN_SECONDS=300
# Leave false. When false, MT5 demo connect fails without a bridge instead of
# silently recording paper trades that never reach MetaTrader 5.
ALLOW_SIMULATED_MT5=false

# Database: PostgreSQL when DATABASE_URL is set, otherwise local SQLite.
# Render free disks are ephemeral, so PostgreSQL is recommended there.
DATABASE_URL=

# AI provider: Mistral only. Without a key, AI review and image analysis are disabled.
# Store the real key in Render Secrets; never commit it.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Telegram alerts (optional). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
PUBLIC_APP_URL=https://rozlf-auto-triding-1.onrender.com

# Optional ExpertOption session cookie: server-side secret only.
# A stored cookie only marks a session as supplied; it is never treated as a live connection.
EXPERTOPTION_SESSION_COOKIE=

# ExpertOption bridge (eo_bridge/, analysis only, never order execution).
# Leave both empty to run the bundled stdlib bridge inside this service on
# 127.0.0.1:8011 (started and supervised automatically). Set them only when you
# deploy eo_bridge/ as its own service:
# EXPERTOPTION_BRIDGE_URL: public URL of the deployed bridge service.
# EXPERTOPTION_BRIDGE_KEY: shared secret the bridge requires (EO_BRIDGE_API_KEY).
# A URL that stops answering makes the backend fall back to the local bridge.
# EO_PYTHON: python interpreter used for the local bridge (default python3).
# EXPERTOPTION_SESSION_TOKEN: ExpertOption session token of your own account,
#   kept server-side only. Never commit it, never send it to the frontend.
EXPERTOPTION_BRIDGE_URL=
EXPERTOPTION_BRIDGE_KEY=
# Session token is stored AES-256-GCM encrypted with APP_SECRET_KEY and restored
# automatically after a restart. Never commit the real value.
EXPERTOPTION_SESSION_TOKEN=
EXPERTOPTION_RESTORE_SESSION=true
# Read a real account (read-only, no orders) without approving real trading.
EXPERTOPTION_ALLOW_REAL_READ=false

# Development-only API bypass. Keep false in production; production uses signed Telegram-paired cookies.
ALLOW_INSECURE_DASHBOARD=false

# Legacy bridge aliases retained for older deployments.
EXPERTOPTION_API_BASE_URL=
EXPERTOPTION_API_KEY=
EXPERTOPTION_API_ACCOUNT=
EXPERTOPTION_API_TIMEOUT_MS=10000
EXPERTOPTION_API_MIN_INTERVAL_MS=250
EXPERTOPTION_API_RETRIES=2
EXPERTOPTION_CANDLE_CACHE_MS=4000
EXPERTOPTION_INSTRUMENT_CACHE_MS=60000
# A candle older than this (and older than 5 x timeframe) blocks the analysis.
EXPERTOPTION_MAX_CANDLE_AGE_SECONDS=120
EXPERTOPTION_MIN_CANDLES=80

# Market data and engine tuning
SCAN_INTERVAL_SECONDS=60
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,XAUUSD
TIMEFRAMES=M5,M15,H1,H4,D1
DEFAULT_RISK_PERCENT=0.5
DEFAULT_DAILY_LOSS_LIMIT_PERCENT=3.0
DEFAULT_MAX_OPEN_TRADES=3
DEFAULT_MAX_DAILY_TRADES=10
DEFAULT_MIN_CONFIDENCE=0.62
DEFAULT_STOP_LOSS_PIPS=0
DEFAULT_TAKE_PROFIT_PIPS=0
MAX_SPREAD_PIPS=3.0
DEMO_START_BALANCE=10000

# Storage (SQLite). On Render free instances this disk is ephemeral.
DATABASE_PATH=
DATA_DIR=
